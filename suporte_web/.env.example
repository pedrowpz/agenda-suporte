# Copie para .env e preencha os valores reais

# ── PostgreSQL ─────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=agendaSuporte
PG_USER=jettax
PG_PASSWORD=jettax2024

# ── Flask ──────────────────────────────────
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
FLASK_ENV=development   # ou production

# ── E-mail (SMTP) ──────────────────────────
# Gmail: habilite "Senha de app" em myaccount.google.com/security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=senha-de-app-do-gmail
